# ── Base de datos ────────────────────────────────────────────
# PostgreSQL (producción / Vercel). Si se define, todo el estado
# se guarda ahí (tabla hachebest_state). Si no, se usa un archivo
# JSON local (db/data.json, o /tmp en Vercel).
DATABASE_URL=

# ── Panel de administración /admin ──────────────────────────
# Por defecto: usuario "HacheJota" y contraseña "HacheAdmin".
# Defínelas en Vercel para personalizarlas.
ADMIN_USER=
ADMIN_PASSWORD=

# ── Sesiones de jugadores (recomendado en producción) ───────
# Secreto con el que se firman las cookies de sesión.
# Genera uno aleatorio, p. ej.:  openssl rand -hex 32
AUTH_SECRET=

# ── Solo modo archivo (sin DATABASE_URL) ─────────────────────
# Ruta alternativa del JSON de datos.
# HACHEBEST_DATA_FILE=
