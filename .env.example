# HacheBest — copia este archivo a .env si quieres personalizar algo (opcional)
# En Vercel puedes configurar estas variables en Project Settings → Environment Variables.

# Contraseña del panel de administración /admin (por defecto: admin123)
ADMIN_PASSWORD=admin123

# Carpeta donde se guarda el archivo de datos (opcional).
# En local se usa ./db/data.json y en Vercel /tmp/hachebest/data.json automáticamente.
# HACHEBEST_DATA_FILE=./db/data.json
